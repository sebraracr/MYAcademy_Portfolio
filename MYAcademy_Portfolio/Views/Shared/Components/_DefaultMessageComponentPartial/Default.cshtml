<!-- Right: Contact Form -->
<div class="col-lg-7 reveal-on-scroll">
    <div class="contact-form-card">

        <!-- id özellikle contactForm değil: eski demo JavaScript'i bu forma karışmasın -->
        <form id="contactFormReal" action="/Contact/Send" method="post">
            @Html.AntiForgeryToken()

            @if (TempData["ContactSuccess"] != null)
            {
                <div class="alert alert-success border-0 rounded-3 small py-2 px-3 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["ContactSuccess"]
                </div>
            }

            @if (TempData["ContactError"] != null)
            {
                <div class="alert alert-danger border-0 rounded-3 small py-2 px-3 mb-4" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2"></i> @TempData["ContactError"]
                </div>
            }

            <div class="row g-3">
                <div class="col-md-6">
                    <label for="contactFullName" class="form-label">Adınız Soyadınız *</label>
                    <input type="text" class="form-control" id="contactFullName" name="NameSurname"
                           placeholder="Örn: Ebrar Acar" minlength="3" maxlength="100" required>
                    <div class="invalid-feedback">Lütfen adınızı ve soyadınızı giriniz.</div>
                </div>

                <div class="col-md-6">
                    <label for="contactEmail" class="form-label">E-posta Adresiniz *</label>
                    <input type="email" class="form-control" id="contactEmail" name="Email"
                           placeholder="Örn: ebrar@example.com" maxlength="150" required>
                    <div class="invalid-feedback">Geçerli bir e-posta adresi giriniz.</div>
                </div>

                <div class="col-12">
                    <label for="contactSubject" class="form-label">Konu *</label>
                    <input type="text" class="form-control" id="contactSubject" name="Subject"
                           placeholder="Örn: Proje İş Birliği veya Danışmanlık" minlength="3" maxlength="150" required>
                    <div class="invalid-feedback">Lütfen mesaj konusunu belirtiniz.</div>
                </div>

                <div class="col-12">
                    <label for="contactMessage" class="form-label">Mesajınız *</label>
                    <textarea class="form-control" id="contactMessage" name="MessageDetail" rows="5"
                              placeholder="Projeniz veya paylaşmak istedikleriniz hakkında detay verebilirsiniz..."
                              minlength="10" maxlength="2000" required></textarea>
                    <div class="invalid-feedback">Lütfen mesajınızı yazınız.</div>
                </div>

                <div class="col-12 mt-4">
                    <button type="submit" class="btn-custom-primary w-100 justify-content-center py-3">
                        <i class="bi bi-send-fill"></i> Mesaj Gönder
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>