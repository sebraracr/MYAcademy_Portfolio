@model List<MYAcademy_Portfolio.Entities.Experience>

@{
    int count = 0;
}

<!-- Work Experience Section -->
<section id="experience">
    <div class="container">

        <div class="text-center mb-5 reveal-on-scroll">
            <span class="section-eyebrow">PROFESYONEL YOLCULUK</span>
            <h2 class="section-title">Deneyimlerim</h2>
            <p class="section-subtitle">
                Gerçek dünya problemlerini çözerken edindiğim tecrübeler.
            </p>
        </div>

        <div class="timeline-container">

            @foreach (var item in Model)
            {
                count++;

                bool isLeft = count % 2 == 1;

                <div class="timeline-item row align-items-center g-4 reveal-on-scroll">

                    <!-- Deneyim Kartı -->
                    <div class="col-lg-6 @(isLeft ? "timeline-left order-lg-1" : "timeline-right order-lg-2") order-2">

                        <div class="timeline-content-card">

                            <div class="d-flex justify-content-between align-items-start mb-2">

                                <span class="badge-year bg-icon-purple">
                                    <i class="bi bi-briefcase"></i> @item.Duration
                                </span>

                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 small">
                                    @item.WorkType
                                </span>

                            </div>

                            <h4 class="fs-5 fw-bold mb-1">
                                @item.Title
                            </h4>

                            <div class="text-primary fw-semibold small mb-3">
                                @item.CompanyName
                            </div>

                            <p class="text-secondary small mb-3" style="line-height: 1.6;">
                                @item.Description
                            </p>

                            <!-- Deneyime Ait Yetenekler -->
                            <div>
                                @foreach (var x in item.Skills)
                                {
                                    <span class="tech-tag">@x.Name</span>
                                }
                            </div>

                        </div>
                    </div>

                    <!-- Timeline İşareti -->
                    <div class="timeline-marker">
                        <i class="bi bi-building"></i>
                    </div>

                    <!-- Yan Açıklama -->
                    <div class="col-lg-6 @(isLeft ? "timeline-right order-lg-2" : "timeline-left order-lg-1") order-1 d-none d-lg-block">

                        <div class="text-secondary small fst-italic">
                            @item.SideTitle
                        </div>

                    </div>

                </div>
            }

        </div>
    </div>
</section>
