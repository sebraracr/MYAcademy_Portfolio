@{
    Layout = null;

    // Breadcrumb için route bilgileri (örn: Admin / Deneyimler / Liste)
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var pageTitle = ViewData["Title"]?.ToString() ?? action;

    // Breadcrumb'da görünecek Türkçe isimler (sayfa vermezse route adları kullanılır)
    var crumbController = ViewData["CrumbController"]?.ToString() ?? controller;
    var crumbAction = ViewData["CrumbAction"]?.ToString() ?? action;

}
<!DOCTYPE html>
<html lang="tr">
<head>
    @* <head> içeriği (meta, başlık, fontlar, Bootstrap) + CSS stilleri *@
    @await Component.InvokeAsync("_AdminLayoutHeadComponentPartial")

    @* Bu satır layout'ta KALMALI: RenderSectionAsync component içinden çağrılamaz *@
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- ==================== SIDEBAR ==================== -->
    @await Component.InvokeAsync("_AdminLayoutSidebarComponentPartial")

    <div class="sidebar-overlay" onclick="toggleSidebar()"></div>

    <!-- ==================== MAIN ==================== -->
    <div id="main-content-wrapper">

        <!-- NAVBAR -->
        <header class="admin-navbar">
            <div class="d-flex align-items-center gap-3">
                <button type="button" class="nav-icon-btn d-lg-none" onclick="toggleSidebar()" aria-label="Menü">
                    <i class="bi bi-list"></i>
                </button>
                <span class="fw-semibold d-none d-sm-inline" style="font-family: 'Plus Jakarta Sans';">Yönetim Paneli</span>
            </div>

            <div class="d-flex align-items-center gap-2">
                <a href="/Default/Index" target="_blank" class="nav-icon-btn" title="Siteyi Görüntüle">
                    <i class="bi bi-box-arrow-up-right"></i>
                </a>
                <a href="/Admin/Message/MessageList" class="nav-icon-btn" title="Mesajlar">
                    <i class="bi bi-envelope"></i>
                </a>

                <div class="dropdown">
                    <button class="nav-user-btn" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="user-avatar">SEA</div>
                        <span class="fw-semibold d-none d-md-inline" style="font-size: 0.85rem;">Sara Ebrar Acar</span>
                        <i class="bi bi-chevron-down small text-secondary d-none d-md-inline"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="/Default/Index"><i class="bi bi-person-circle"></i> Profilim</a></li>
                        <li><a class="dropdown-item" href="/Admin/Setting/Index"><i class="bi bi-gear"></i> Ayarlar</a></li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- BREADCRUMB / URL -->
        <div class="page-header">
            <h1>@pageTitle</h1>
        </div>

        <!-- CONTENT -->
        <main class="main-body-container">
            @RenderBody()
        </main>

        <!-- FOOTER -->
        <footer class="admin-footer">
            <span>© @DateTime.Now.Year Sara Ebrar. Portfolio Admin — Tüm hakları saklıdır.</span>
            <span>
                <a href="/" target="_blank">Siteyi Görüntüle</a>
                <span class="mx-2">•</span>
                <span>v1.0</span>
            </span>
        </footer>
    </div>

    @* JavaScript (Bootstrap + menü aç/kapa) *@
    @await Component.InvokeAsync("_AdminLayoutScriptComponentPartial")

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
