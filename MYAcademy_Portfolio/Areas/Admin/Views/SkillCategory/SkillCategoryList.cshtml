@model List<MYAcademy_Portfolio.Entities.SkillCategory>
@{
    ViewData["Title"] = "Yetenek Kategorileri";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    var kategoriler = Model.OrderBy(x => x.SkillCategoryId).ToList();

    var toplamKategori = kategoriler.Count;
    var toplamYetenek = kategoriler.Sum(x => x.Skills?.Count ?? 0);
    var bosKategori = kategoriler.Count(x => x.Skills == null || !x.Skills.Any());

    const int gosterilecekEtiket = 6;
    int count = 0;
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

<style>
    .cat-page {
        --bg: #f4f3ef;
        --surface: #fffefb;
        --line: #ebe8df;
        --ink: #1f2421;
        --muted: #7b807c;
        --green: #86a08b;
        --green-soft: #e3ece5;
        --blue-soft: #e4edf6;
        --rose-soft: #f4e6e1;
        --rose-ink: #b4584a;
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        color: var(--ink);
        padding: 24px;
    }

    .cat-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 22px;
    }

        .cat-header p {
            margin: 2px 0 0;
            font-size: 13px;
            color: var(--muted);
        }

    .btn-new {
        background: var(--green);
        color: #fff;
        border: 0;
        border-radius: 10px;
        padding: 9px 16px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }

        .btn-new:hover {
            background: #75927b;
            color: #fff;
        }

    .stat-row {
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
        margin-bottom: 26px;
    }

    .stat-card {
        flex: 0 1 280px;
        min-width: 220px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 16px 18px;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        font-size: 18px;
    }

        .stat-icon.cats {
            background: var(--green-soft);
            color: #5d7a64;
        }

        .stat-icon.skills {
            background: var(--blue-soft);
            color: #587a9c;
        }

        .stat-icon.empty {
            background: var(--rose-soft);
            color: #9a7a6c;
        }

    .stat-label {
        font-size: 11px;
        color: var(--muted);
        font-weight: 500;
    }

    .stat-value {
        font-size: 22px;
        font-weight: 700;
        line-height: 1.15;
    }

    .list-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 16px;
        overflow: hidden;
    }

    .list-tools {
        padding: 18px 16px;
    }

    .search-box {
        position: relative;
        display: inline-block;
    }

        .search-box i {
            position: absolute;
            left: 11px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--muted);
            font-size: 13px;
        }

        .search-box input {
            border: 1px solid var(--line);
            background: var(--bg);
            border-radius: 9px;
            font-size: 12px;
            padding: 8px 12px 8px 32px;
            width: 300px;
            max-width: 100%;
            color: var(--ink);
            font-family: inherit;
        }

            .search-box input:focus {
                outline: 2px solid var(--green);
                outline-offset: 1px;
            }

    .cat-table-wrap {
        overflow-x: auto;
    }

    table.cat-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 820px;
    }

    .cat-table thead th {
        background: #faf9f5;
        font-size: 11px;
        font-weight: 600;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: .04em;
        padding: 12px 16px;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        text-align: left;
    }

        .cat-table thead th:last-child,
        .cat-table td.actions {
            text-align: right;
        }

    .cat-table tbody td {
        padding: 14px 16px;
        border-bottom: 1px solid var(--line);
        font-size: 13px;
        vertical-align: middle;
    }

    .cat-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .cat-table tbody tr:hover {
        background: #faf9f4;
    }

    .row-id {
        font-weight: 600;
    }

    .name-cell {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 240px;
    }

    .name-icon {
        width: 36px;
        height: 36px;
        flex-shrink: 0;
        border-radius: 10px;
        background: #eeeafe;
        color: #8276d9;
        display: grid;
        place-items: center;
        font-size: 15px;
    }

    .name-main {
        font-weight: 600;
        font-size: 13px;
    }

    .name-sub {
        font-size: 11px;
        color: var(--muted);
        max-width: 280px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .tag-list {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        max-width: 460px;
    }

    .tag {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 3px 9px;
        font-size: 11px;
        font-weight: 600;
    }

        .tag i {
            color: #2f8f5b;
            font-size: 10px;
        }

        .tag.more {
            background: #f1f0ea;
            color: var(--muted);
            font-weight: 500;
        }

    .tag-none {
        font-size: 12px;
        color: var(--muted);
    }

    .count-badge {
        display: inline-block;
        min-width: 28px;
        text-align: center;
        background: var(--green-soft);
        color: #3f6a4c;
        border: 1px solid #cfe0d3;
        border-radius: 999px;
        padding: 3px 10px;
        font-size: 11px;
        font-weight: 600;
    }

    .act-btn {
        width: 30px;
        height: 30px;
        display: inline-grid;
        place-items: center;
        border: 1px solid var(--line);
        background: var(--surface);
        border-radius: 8px;
        color: #555a56;
        font-size: 13px;
        text-decoration: none;
        margin-left: 4px;
        transition: background .15s, color .15s, border-color .15s;
    }

        .act-btn:hover {
            background: var(--bg);
            color: var(--ink);
        }

        .act-btn.danger:hover {
            background: var(--rose-soft);
            color: var(--rose-ink);
            border-color: #ecd2cb;
        }

    .empty-row td {
        text-align: center;
        color: var(--muted);
        padding: 36px 16px !important;
    }
</style>

<div class="cat-page">

    <div class="cat-header">
        <div>
            <p>Sitedeki yetenek kartlarını (Backend, Frontend gibi) ve her kartın altındaki yetenekleri buradan yönetebilirsiniz.</p>
        </div>
        <a href="/Admin/SkillCategory/CreateSkillCategory" class="btn-new">
            <i class="bi bi-plus-circle-fill"></i> Yeni Kategori Ekle
        </a>
    </div>

   

    <div class="list-card">
        <div class="list-tools">
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" id="catSearch" placeholder="Kategori veya yetenek adına göre ara..." />
            </div>
        </div>

        <div class="cat-table-wrap">
            <table class="cat-table" id="catTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Yetenek Kategorisi</th>
                        <th>Yeteneklerim</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in kategoriler)
                    {
                        count++;
                        var yetenekler = (item.Skills ?? new List<MYAcademy_Portfolio.Entities.Skill>())
                            .OrderBy(s => s.Name)
                            .ToList();
                        var kalan = yetenekler.Count - gosterilecekEtiket;
                        var ikon = string.IsNullOrWhiteSpace(item.Icon) ? "bi-tag" : item.Icon;

                        <tr data-row>
                            <td class="row-id">#@count</td>
                            <td>
                                <div class="name-cell">
                                    <div class="name-icon"><i class="bi @ikon"></i></div>
                                    <div>
                                        <div class="name-main">@item.Name</div>
                                        <div class="name-sub">@item.Description</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (yetenekler.Any())
                                {
                                    <div class="tag-list">
                                        @foreach (var skill in yetenekler.Take(gosterilecekEtiket))
                                        {
                                            <span class="tag"><i class="bi bi-check2"></i>@skill.Name</span>
                                        }
                                        @if (kalan > 0)
                                        {
                                            <span class="tag more">+@kalan daha</span>
                                        }
                                    </div>
                                    @* Aramada tüm yetenek adları bulunsun diye gizli metin *@
                                    <span hidden>@string.Join(" ", yetenekler.Select(s => s.Name))</span>
                                }
                                else
                                {
                                    <span class="tag-none">Henüz yetenek eklenmedi</span>
                                }
                            </td>
                            <td class="actions">
                                <a href="/Admin/SkillCategory/UpdateSkillCategory/@item.SkillCategoryId" class="act-btn" title="Güncelle">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a href="/Admin/SkillCategory/DeleteSkillCategory/@item.SkillCategoryId" class="act-btn danger js-delete"
                                   data-count="@yetenekler.Count" title="Sil">
                                    <i class="bi bi-trash3"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    <tr class="empty-row" id="catEmpty" style="@(kategoriler.Any() ? "display:none;" : "")">
                        <td colspan="5">@(kategoriler.Any() ? "Aramanızla eşleşen kategori bulunamadı." : "Henüz kategori eklenmedi.")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        (function () {
            var search = document.getElementById('catSearch');
            var rows = document.querySelectorAll('#catTable tbody tr[data-row]');
            var empty = document.getElementById('catEmpty');

            // Türkçe karakterleri sadeleştirir: İ, I, ı → i | ğ → g | ş → s ...
            function normalize(text) {
                return (text || '')
                    .toLocaleLowerCase('tr-TR')
                    .replace(/ı/g, 'i')
                    .normalize('NFD')
                    .replace(/[\u0300-\u036f]/g, '');
            }

            var index = [];
            rows.forEach(function (row) {
                index.push({ row: row, text: normalize(row.textContent) });
            });

            search.addEventListener('input', function () {
                var q = normalize(search.value.trim());
                var visible = 0;

                index.forEach(function (item) {
                    var ok = !q || item.text.indexOf(q) > -1;
                    item.row.style.display = ok ? '' : 'none';
                    if (ok) visible++;
                });

                if (rows.length > 0) {
                    empty.style.display = visible === 0 ? '' : 'none';
                }
            });

            // Silme onayı (SweetAlert2)
            document.addEventListener('click', function (e) {
                var del = e.target.closest('.js-delete');
                if (!del) return;
                e.preventDefault();

                var href = del.getAttribute('href');
                var count = parseInt(del.dataset.count, 10) || 0;
                var text = count > 0
                    ? 'Bu kategoriye bağlı ' + count + ' yetenek var. Bu işlem geri alınamaz.'
                    : 'Bu işlem geri alınamaz.';

                Swal.fire({
                    title: 'Kategori silinsin mi?',
                    text: text,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Evet, sil',
                    cancelButtonText: 'Vazgeç',
                    confirmButtonColor: '#b4584a',
                    cancelButtonColor: '#86a08b',
                    reverseButtons: true
                }).then(function (result) {
                    if (result.isConfirmed) window.location.href = href;
                });
            });

            // İşlem sonucu bildirimi (TempData) — başarılı
            var flash = @Json.Serialize(TempData["Success"]?.ToString() ?? "");
            if (flash) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: flash,
                    showConfirmButton: false,
                    timer: 2600,
                    timerProgressBar: true
                });
            }

            // İşlem sonucu bildirimi (TempData) — hata
            var flashError = @Json.Serialize(TempData["Error"]?.ToString() ?? "");
            if (flashError) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'error',
                    title: flashError,
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
            }

        })();
    </script>
}
