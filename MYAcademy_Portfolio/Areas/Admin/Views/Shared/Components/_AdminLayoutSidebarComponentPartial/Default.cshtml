@{
    // Şu an hangi controller'dayız? (aktif menüyü vurgulamak için)
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    string Active(string ctrl) =>
        string.Equals(controller, ctrl, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}

<aside id="sidebar-wrapper">
    <a href="/Admin/Dashboard/Index" class="sidebar-brand">
        <div class="brand-mark">SEA</div>
        <div>
            <div class="fw-bold text-white lh-1" style="font-family: 'Plus Jakarta Sans';">Sara Ebrar Acar.</div>
            <small class="text-white-50" style="font-size: 0.72rem;">Portfolio Admin</small>
        </div>
    </a>

    <nav class="sidebar-nav">
        <div class="nav-group-title">Genel</div>
        <a href="/Admin/Dashboard/Index" class="sidebar-link @Active("Dashboard")">
            <i class="bi bi-speedometer2"></i><span>Dashboard</span>
        </a>
        <a href="/Default/Index" target="_blank" class="sidebar-link">
            <i class="bi bi-box-arrow-up-right"></i><span>Siteye Git</span>
        </a>

        <div class="nav-group-title">İçerik</div>
        <a href="/Admin/About/UpdateAbout" class="sidebar-link @Active("About")">
            <i class="bi bi-person"></i><span>Hakkımda</span>
        </a>
        <a href="/Admin/Education/EducationList" class="sidebar-link @Active("Education")">
            <i class="bi bi-mortarboard"></i><span>Eğitim</span>
        </a>
        <a href="/Admin/Experience/ExperienceList" class="sidebar-link @Active("Experience")">
            <i class="bi bi-briefcase"></i><span>Deneyimler</span>
        </a>
        <a href="/Admin/SkillCategory/SkillCategoryList" class="sidebar-link @Active("SkillCategory")">
            <i class="bi bi-code-slash"></i><span>Yetenek Kategorileri</span>
        </a>
        <a href="/Admin/Project/ProjectList" class="sidebar-link @Active("Project")">
            <i class="bi bi-grid"></i><span>Projeler</span>
        </a>
        <a href="/Admin/Category/CategoryList" class="sidebar-link @Active("Category")">
            <i class="bi bi-folder2"></i><span>Proje Kategorileri</span>
        </a>

        <div class="nav-group-title">İletişim & Sistem</div>
        <a href="/Admin/Message/MessageList" class="sidebar-link @Active("Message")">
            <i class="bi bi-envelope"></i><span>Mesajlar</span>
        </a>
        <a href="/Admin/SocialMedia/SocialMediaList" class="sidebar-link @Active("SocialMedia")">
            <i class="bi bi-share"></i><span>Sosyal Medya</span>
        </a>
        <a href="/Admin/Setting/Index" class="sidebar-link @Active("Setting")">
            <i class="bi bi-gear"></i><span>Ayarlar</span>
        </a>
    </nav>

    <div class="sidebar-user">
        <div class="user-avatar">SEA</div>
        <div class="overflow-hidden">
            <div class="fw-semibold text-white text-truncate" style="font-size: 0.83rem;">Sara Ebrar Acar</div>
            <div style="font-size: 0.7rem; color: #B3BFDF;">Yönetici</div>
        </div>
    </div>
</aside>
