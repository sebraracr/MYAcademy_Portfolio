@model MYAcademy_Portfolio.Areas.Admin.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    // Kategori çubukları için en büyük değer (çubuk genişliğini oranlamak için)
    var enBuyuk = Model.CategorySummaries.Any() ? Model.CategorySummaries.Max(x => x.ProjectCount) : 1;

    // Kartlar: başlık, değer, ikon, renk, link
    var kartlar = new[]
    {
        new { Baslik = "Toplam Proje",     Deger = Model.TotalProjectCount,  Ikon = "bi-grid",              Renk = "blue",   Link = "/Admin/Project/ProjectList" },
        new { Baslik = "Aktif Proje",      Deger = Model.ActiveProjectCount, Ikon = "bi-eye",               Renk = "green",  Link = "/Admin/Project/ProjectList" },
        new { Baslik = "Yetenek",          Deger = Model.SkillCount,         Ikon = "bi-code-slash",        Renk = "purple", Link = "/Admin/SkillCategory/SkillCategoryList" },
        new { Baslik = "Deneyim",          Deger = Model.ExperienceCount,    Ikon = "bi-briefcase",         Renk = "peach",  Link = "/Admin/Experience/ExperienceList" },
        new { Baslik = "Eğitim",           Deger = Model.EducationCount,     Ikon = "bi-mortarboard",       Renk = "sky",    Link = "/Admin/Education/EducationList" },
        new { Baslik = "Toplam Mesaj",     Deger = Model.MessageCount,       Ikon = "bi-envelope",          Renk = "blue",   Link = "/Admin/Message/MessageList" },
        new { Baslik = "Okunmamış Mesaj",  Deger = Model.UnreadMessageCount, Ikon = "bi-envelope-exclamation", Renk = "rose", Link = "/Admin/Message/MessageList" },
    };
}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />

<style>
    .dash {
        --bg: #f4f3ef;
        --surface: #fffefb;
        --line: #ebe8df;
        --ink: #1f2421;
        --muted: #7b807c;
        --green: #86a08b;
        --green-soft: #e3ece5;
        --blue-soft: #e4edf6;
        --rose-soft: #f4e6e1;
        --rose-ink: #b4584a;
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        color: var(--ink);
        padding: 8px 0 24px;
    }

    .dash-hello {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 22px;
    }

        .dash-hello p {
            margin: 0;
            font-size: 13px;
            color: var(--muted);
        }

    /* ── İstatistik kartları ── */
    .stat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
        gap: 14px;
        margin-bottom: 22px;
    }

    .stat-card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 16px;
        display: flex;
        align-items: center;
        gap: 14px;
        text-decoration: none;
        color: var(--ink);
        transition: transform .15s, box-shadow .15s;
    }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 22px rgba(31, 36, 33, .06);
            color: var(--ink);
        }

    .stat-icon {
        width: 44px;
        height: 44px;
        flex-shrink: 0;
        border-radius: 12px;
        display: grid;
        place-items: center;
        font-size: 18px;
    }

        .stat-icon.blue {
            background: var(--blue-soft);
            color: #587a9c;
        }

        .stat-icon.green {
            background: var(--green-soft);
            color: #4f6b55;
        }

        .stat-icon.purple {
            background: #eeeafe;
            color: #7568c9;
        }

        .stat-icon.peach {
            background: #fbeee2;
            color: #a8724a;
        }

        .stat-icon.sky {
            background: #e3f3f7;
            color: #4b8796;
        }

        .stat-icon.rose {
            background: var(--rose-soft);
            color: var(--rose-ink);
        }

    .stat-label {
        font-size: 11px;
        color: var(--muted);
        font-weight: 500;
    }

    .stat-value {
        font-size: 24px;
        font-weight: 700;
        line-height: 1.1;
    }

    /* ── Paneller ── */
    .panel-grid {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 18px;
        margin-bottom: 18px;
    }

    .panel {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 16px;
        overflow: hidden;
    }

    .panel-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 18px;
        border-bottom: 1px solid var(--line);
    }

        .panel-head h3 {
            margin: 0;
            font-size: 14px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .panel-head a {
            font-size: 12px;
            color: var(--muted);
            text-decoration: none;
        }

            .panel-head a:hover {
                color: var(--ink);
            }

    .panel-body {
        padding: 6px 0;
    }

    .panel-empty {
        padding: 28px 18px;
        text-align: center;
        font-size: 13px;
        color: var(--muted);
    }

    /* Son mesajlar */
    .msg-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 11px 18px;
        text-decoration: none;
        color: var(--ink);
        border-bottom: 1px solid var(--line);
    }

        .msg-item:last-child {
            border-bottom: 0;
        }

        .msg-item:hover {
            background: #faf9f4;
            color: var(--ink);
        }

    .msg-avatar {
        width: 36px;
        height: 36px;
        flex-shrink: 0;
        border-radius: 50%;
        background: var(--green-soft);
        color: #4f6b55;
        display: grid;
        place-items: center;
        font-weight: 700;
        font-size: 13px;
    }

    .msg-main {
        flex: 1;
        min-width: 0;
    }

    .msg-name {
        font-size: 13px;
        font-weight: 600;
    }

    .msg-subject {
        font-size: 12px;
        color: var(--muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .msg-item.unread .msg-name::after {
        content: "";
        display: inline-block;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--rose-ink);
        margin-left: 6px;
        vertical-align: middle;
    }

    .msg-date {
        font-size: 11px;
        color: var(--muted);
        white-space: nowrap;
    }

    .badge-soft {
        display: inline-block;
        border-radius: 999px;
        padding: 2px 9px;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }

        .badge-soft.read {
            background: var(--green-soft);
            color: #3f6a4c;
        }

        .badge-soft.unread {
            background: var(--rose-soft);
            color: var(--rose-ink);
        }

        .badge-soft.active {
            background: var(--green-soft);
            color: #3f6a4c;
        }

        .badge-soft.passive {
            background: #f1f0ea;
            color: var(--muted);
        }

        .badge-soft.cat {
            background: #eeeafe;
            color: #6a5ec4;
        }

    /* Kategori özeti */
    .cat-row {
        padding: 10px 18px;
    }

    .cat-top {
        display: flex;
        justify-content: space-between;
        font-size: 12.5px;
        margin-bottom: 6px;
    }

        .cat-top b {
            font-weight: 700;
        }

    .cat-bar {
        height: 8px;
        background: var(--bg);
        border-radius: 999px;
        overflow: hidden;
    }

    .cat-fill {
        height: 100%;
        background: var(--green);
        border-radius: 999px;
    }

    /* Son projeler */
    .prj-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 11px 18px;
        border-bottom: 1px solid var(--line);
    }

        .prj-item:last-child {
            border-bottom: 0;
        }

    .prj-thumb {
        width: 54px;
        height: 36px;
        flex-shrink: 0;
        border-radius: 8px;
        object-fit: cover;
        border: 1px solid var(--line);
        background: var(--bg);
        display: grid;
        place-items: center;
        color: var(--muted);
    }

    .prj-main {
        flex: 1;
        min-width: 0;
    }

    .prj-title {
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .prj-meta {
        display: flex;
        gap: 6px;
        margin-top: 4px;
        flex-wrap: wrap;
    }

    .edit-btn {
        width: 32px;
        height: 32px;
        display: grid;
        place-items: center;
        border: 1px solid var(--line);
        border-radius: 8px;
        color: #555a56;
        text-decoration: none;
        background: var(--surface);
    }

        .edit-btn:hover {
            background: var(--bg);
            color: var(--ink);
        }

    /* Hızlı işlemler */
    .quick-grid {
        display: grid;
        gap: 10px;
        padding: 14px 18px 18px;
    }

    .quick-btn {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border: 1px solid var(--line);
        border-radius: 12px;
        text-decoration: none;
        color: var(--ink);
        font-size: 13px;
        font-weight: 600;
        transition: background .15s, border-color .15s;
    }

        .quick-btn:hover {
            background: var(--bg);
            border-color: var(--green);
            color: var(--ink);
        }

        .quick-btn i.lead {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            display: grid;
            place-items: center;
            font-size: 15px;
        }

        .quick-btn small {
            display: block;
            font-weight: 400;
            font-size: 11px;
            color: var(--muted);
        }

        .quick-btn .arrow {
            margin-left: auto;
            color: var(--muted);
        }

    @@media (max-width: 991px) {
        .panel-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="dash">

    <div class="dash-hello">
        <p>Portfolyonuzun genel durumu. Tüm sayılar veritabanından anlık hesaplanır.</p>
    </div>

    <!-- ── 1) İSTATİSTİK KARTLARI ── -->
    <div class="stat-grid">
        @foreach (var k in kartlar)
        {
            <a href="@k.Link" class="stat-card">
                <div class="stat-icon @k.Renk"><i class="bi @k.Ikon"></i></div>
                <div>
                    <div class="stat-label">@k.Baslik</div>
                    <div class="stat-value">@k.Deger</div>
                </div>
            </a>
        }
    </div>

    <div class="panel-grid">

        <!-- ── 2) SON 5 MESAJ ── -->
        <div class="panel">
            <div class="panel-head">
                <h3><i class="bi bi-envelope"></i> Son Mesajlar</h3>
                <a href="/Admin/Message/MessageList">Tümünü gör →</a>
            </div>
            <div class="panel-body">
                @if (!Model.LastMessages.Any())
                {
                    <div class="panel-empty">Henüz mesaj yok.</div>
                }
                @foreach (var m in Model.LastMessages)
                {
                    var harf = string.IsNullOrWhiteSpace(m.NameSurname) ? "?" : m.NameSurname.Trim().Substring(0, 1).ToUpper();
                    <a href="/Admin/Message/MessageList?open=@m.MessageId" class="msg-item @(m.IsRead ? "" : "unread")">
                        <div class="msg-avatar">@harf</div>
                        <div class="msg-main">
                            <div class="msg-name">@m.NameSurname</div>
                            <div class="msg-subject">@m.Subject</div>
                        </div>
                        <div class="text-end">
                            <div class="msg-date">@m.SendDate.ToString("dd.MM.yyyy HH:mm")</div>
                            <span class="badge-soft @(m.IsRead ? "read" : "unread")">@(m.IsRead ? "Okundu" : "Yeni")</span>
                        </div>
                    </a>
                }
            </div>
        </div>

        <!-- ── 4) KATEGORİ ÖZETİ ── -->
        <div class="panel">
            <div class="panel-head">
                <h3><i class="bi bi-bar-chart"></i> Kategori Özeti</h3>
                <a href="/Admin/Category/CategoryList">Kategoriler →</a>
            </div>
            <div class="panel-body">
                @if (!Model.CategorySummaries.Any())
                {
                    <div class="panel-empty">Henüz proje eklenmedi.</div>
                }
                @foreach (var c in Model.CategorySummaries)
                {
                    var yuzde = enBuyuk > 0 ? c.ProjectCount * 100 / enBuyuk : 0;
                    <div class="cat-row">
                        <div class="cat-top">
                            <span>@c.CategoryName</span>
                            <b>@c.ProjectCount proje</b>
                        </div>
                        <div class="cat-bar"><div class="cat-fill" style="width:@(yuzde)%"></div></div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="panel-grid">

        <!-- ── 3) SON 3 PROJE ── -->
        <div class="panel">
            <div class="panel-head">
                <h3><i class="bi bi-grid"></i> Son Projeler</h3>
                <a href="/Admin/Project/ProjectList">Tümünü gör →</a>
            </div>
            <div class="panel-body">
                @if (!Model.LastProjects.Any())
                {
                    <div class="panel-empty">Henüz proje eklenmedi.</div>
                }
                @foreach (var p in Model.LastProjects)
                {
                    <div class="prj-item">
                        @if (!string.IsNullOrWhiteSpace(p.CoverImageUrl))
                        {
                            <img src="@p.CoverImageUrl" alt="@p.Title" class="prj-thumb" />
                        }
                        else
                        {
                            <div class="prj-thumb"><i class="bi bi-image"></i></div>
                        }
                        <div class="prj-main">
                            <div class="prj-title">@p.Title</div>
                            <div class="prj-meta">
                                <span class="badge-soft cat">@(p.Category?.CategoryName ?? "Kategorisiz")</span>
                                <span class="badge-soft @(p.IsActive ? "active" : "passive")">@(p.IsActive ? "Yayında" : "Pasif")</span>
                            </div>
                        </div>
                        <a href="/Admin/Project/UpdateProject/@p.ProjectId" class="edit-btn" title="Düzenle">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- ── 5) HIZLI İŞLEMLER ── -->
        <div class="panel">
            <div class="panel-head">
                <h3><i class="bi bi-lightning-charge"></i> Hızlı İşlemler</h3>
            </div>
            <div class="quick-grid">
                <a href="/Admin/Project/CreateProject" class="quick-btn">
                    <i class="bi bi-plus-lg lead" style="background:var(--green-soft);color:#4f6b55;"></i>
                    <span>Yeni Proje Ekle<small>Portfolyona yeni bir çalışma ekle</small></span>
                    <i class="bi bi-chevron-right arrow"></i>
                </a>
                <a href="/Admin/Message/MessageList" class="quick-btn">
                    <i class="bi bi-envelope lead" style="background:var(--blue-soft);color:#587a9c;"></i>
                    <span>Mesajları Görüntüle<small>@Model.UnreadMessageCount okunmamış mesaj</small></span>
                    <i class="bi bi-chevron-right arrow"></i>
                </a>
                <a href="/Default/Index" target="_blank" class="quick-btn">
                    <i class="bi bi-globe2 lead" style="background:#eeeafe;color:#7568c9;"></i>
                    <span>Portfolyoyu Aç<small>Siteyi yeni sekmede görüntüle</small></span>
                    <i class="bi bi-box-arrow-up-right arrow"></i>
                </a>
            </div>
        </div>
    </div>
</div>
